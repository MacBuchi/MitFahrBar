<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ohne diese Berechtigung hat der Release-Build keinen Netzzugriff:
         Supabase ist dann unerreichbar und der Login schlägt fehl. Die
         Flutter-Vorlage deklariert sie nur für debug/profile. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Die heruntergeladene APK an den Android-Installer übergeben dürfen.
         Ohne diese Berechtigung endet das In-App-Update im Nichts. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Seit Android 13 muss die App das Anzeigen von Benachrichtigungen
         erfragen. Ohne diese Deklaration lässt sich die Berechtigung gar
         nicht erst anfordern: Der Dialog erscheint nie, die App hält sich
         für abgelehnt und der Abend-Push kommt stillschweigend nirgends an
         (Issue #101). Gefragt wird erst beim Einschalten im Screen, nicht
         beim Start. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Backup bleibt an (es gibt lokal nichts Wertvolles zu verlieren), aber
         die Sitzung ist ausgenommen: Eine Gruppe = ein Login, das Token ist
         also das gemeinsame Zugangsmerkmal der Gruppe und hat im Cloud-Backup
         eines einzelnen Mitglieds nichts verloren. Beide Attribute nötig —
         fullBackupContent bis Android 11, dataExtractionRules ab Android 12. -->
    <application
        android:label="MitFahrBar"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Pflicht für das In-App-Update: reicht die geladene APK an den
             System-Installer heraus (MainActivity.kt, Kanal apk_install —
             der Nachbau ohne ota_update, Muster von PilzBuddy #161). Ab
             Android 7 ist eine file://-URI dafür verboten; der Installer
             läuft in einem fremden Prozess und bekommt die Datei über eine
             content-URI mit erteilter Leseerlaubnis. Die Authority muss
             wörtlich zu MainActivity.installApk passen; fehlt der Provider,
             stürzt die App NACH erfolgreichem Download ab – nie im
             Debug-Lauf, sondern erst beim ersten echten Update am Gerät.
             `exported="false"`: Nur wer die Erlaubnis erteilt bekommt, darf
             lesen — die Datei ist nicht für Dritte offen. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
        <!-- Push-Benachrichtigungen (#101). Der Kanal wird in MainActivity.kt
             angelegt; steht er hier, ohne zu existieren, weicht FCM auf einen
             eigenen Kanal namens „Miscellaneous" aus. Das Icon zeigt bewusst
             auf den Adaptive-Icon-Vordergrund: Android macht aus jedem
             Benachrichtigungs-Icon eine Silhouette über den Alphakanal, und
             der Vordergrund ist die einzige erzeugte Fassung der Bildmarke
             mit transparentem Hintergrund (tool/brand/build_icons.sh). Ohne
             die Angabe nähme Android das farbige Launcher-Icon und zeigte
             einen weißen Klotz. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_plan_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher_foreground" />
        <!-- Ohne diese Angabe färbt Android das kleine Icon und die
             App-Zeile grau. Der Wert steht in res/values/colors.xml und
             res/values-night/colors.xml — hell und dunkel brauchen
             verschiedene Töne, weil der Schatten die Helligkeit des Systems
             hat und nicht die der App. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Seit Android 11 (Package Visibility) sieht die App fremde Apps
             nur, wenn sie danach fragt. Ohne diesen Block findet
             url_launcher keinen Browser, liefert still `false` – und der
             Download-Knopf tut sichtbar nichts. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
