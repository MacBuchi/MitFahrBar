<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup-Regeln für Android 11 und älter (android:fullBackupContent).

  supabase_flutter legt die Sitzung unter dem Schlüssel
  "sb-<projekt>-auth-token" ab; Flutters SharedPreferences schreibt jeden
  Schlüssel in die eine Datei shared_prefs/FlutterSharedPreferences.xml.
  Backup-Regeln adressieren immer ganze Dateien, nie einzelne Schlüssel —
  der Ausschluss muss also die komplette Datei nennen.

  Warum überhaupt: Eine Gruppe = ein Login. Das Sitzungs-Token ist damit das
  gemeinsame Zugangsmerkmal der ganzen Gruppe und soll nicht über das
  Google-Konto einer einzelnen Person auf fremde Geräte wandern.

  Seit #121 steht in derselben Datei auch die Geräte-Zuordnung („Ich bin",
  data/device_identity.dart) — bis dahin war shared_preferences keine direkte
  Abhängigkeit und die Datei enthielt nur Sitzung und PKCE-Zustand. Der
  Ausschluss bleibt trotzdem, denn das Token wiegt schwerer.

  Der Preis ist bewusst in Kauf genommen: Die Zuordnung überlebt keinen
  Gerätewechsel, das neue Gerät fragt erneut. Das ist der richtige Ausgang —
  ein neues Gerät gehört oft einer anderen Person. Wer hier künftig etwas
  ablegt, das eine Sicherung überstehen MUSS, braucht dafür eine eigene
  Datei; einzelne Schlüssel lassen sich nicht ausnehmen.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    <!-- Die geladene Update-APK (~60 MB, reiner Zwischenschritt): Sie
         sprengte das 25-MB-Kontingent und ließe das GANZE Backup
         scheitern — dieselbe Lehre wie in PilzBuddy. -->
    <exclude domain="file" path="updates"/>
</full-backup-content>
