<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup-Regeln ab Android 12 (android:dataExtractionRules).

  Begründung siehe backup_rules.xml. Ab Android 12 zerfällt die Regel in zwei
  getrennte Fälle, und die Sitzung muss aus BEIDEN heraus: cloud-backup ist
  die Sicherung ins Google-Konto, device-transfer der direkte Umzug auf ein
  neues Gerät. Nur einen der beiden zu füllen lässt das Token auf dem anderen
  Weg trotzdem mitreisen.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
