<?xml version="1.0" encoding="utf-8"?>
<!-- Pfade, die der FileProvider für das In-App-Update freigeben darf.
     Der eigene Updater (data/update_installer.dart) legt die geladene APK
     unter files/updates/ ab. Bewusst NUR dieser Ordner: Im selben
     Verzeichnis liegt die SharedPreferences-Datei mit dem Sitzungs-Token
     der Gruppe — der frühere external-path-Eintrag von ota_update ist mit
     dem Paket entfallen. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="updates" path="updates/"/>
</paths>
